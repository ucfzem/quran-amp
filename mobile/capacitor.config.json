{
  "appId": "com.ucfzem.quranamp",
  "appName": "Quran Amp",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#120e0b",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
